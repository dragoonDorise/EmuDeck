<?xml version="1.0"?>
<!-- This is the ES-DE find rules configuration file for macOS -->
<ruleList>
    <emulator name="OS-SHELL">
        <rule type="systempath">
            <entry>bash</entry>
            <entry>sh</entry>
        </rule>
    </emulator>
    <core name="RETROARCH">
        <rule type="corepath">
            <entry>~/Library/Application Support/RetroArch/cores</entry>
        </rule>
    </core>
    <emulator name="ARMSX2">
        <rule type="staticpath">
            <entry>EMULATIONPATH/tools/launchers/armsx2.sh</entry>
        </rule>
    </emulator>
    <emulator name="AZAHAR">
        <rule type="staticpath">
            <entry>EMULATIONPATH/tools/launchers/azahar.sh</entry>
