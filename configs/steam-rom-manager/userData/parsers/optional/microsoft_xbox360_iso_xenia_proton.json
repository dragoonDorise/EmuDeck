{
  "parserType": "Glob",
  "configTitle": "Microsoft Xbox 360 - Xenia",
  "steamDirectory": "${steamdirglobal}",
  "romDirectory": "${romsdirglobal}/xbox360",
  "executableArgs": "\"Z:${filePath}\"",
  "executableModifier": "\"${exePath}\"",
  "startInDirectory": "",
  "titleModifier": "${fuzzyTitle}",
  "imageProviders": ["sgdb", "steamCDN"],
  "onlineImageQueries": "${${fuzzyTitle}}",
  "imagePool": "${fuzzyTitle}",
  "userAccounts": {
    "specifiedAccounts": ["Global"]
  },
  "executable": {
    "path": "/run/media/mmcblk0p1/Emulation/tools/launchers/xenia.sh",
    "shortcutPassthrough": false,
    "appendArgsToExecutable": true
  },
  "parserInputs": {
    "glob": "{roms/**/!(xbla),roms}/**/${title}@(.iso|.ISO|.xex|.XEX|.zar|.ZAR)"
  },
  "titleFromVariable": {
    "limitToGroups": "",
    "caseInsensitiveVariables": false,
    "skipFileIfVariableWasNotFound": false
  },
  "fuzzyMatch": {
    "replaceDiacritics": true,
    "removeCharacters": true,
    "removeBrackets": true
  },
  "controllers": {
    "ps4": null,
    "ps5": null,
    "xbox360": null,
    "xboxone": null,
    "switch_joycon_left": null,
    "switch_joycon_right": null,
    "switch_pro": null,
    "neptune": null
  },
  "imageProviderAPIs": {
    "sgdb": {
      "nsfw": false,
      "humor": false,
      "styles": [],
      "stylesHero": [],
      "stylesLogo": [],
      "stylesIcon": [],
      "imageMotionTypes": ["static"]
    }
  },
  "defaultImage": {
    "tall": "",
    "long": "",
    "hero": "",
    "logo": "",
    "icon": "/home/deck/.config/EmuDeck/backend/configs/steam-rom-manager/userData/img/default/icon.png"
  },
  "localImages": {
    "tall": "",
    "long": "",
    "hero": "",
    "logo": "",
    "icon": ""
  },
  "parserId": "135113607715086732",
  "version": 22,
  "steamInputEnabled": "1",
  "drmProtect": false,
  "steamCategories": ["Microsoft Xbox 360"]
}
